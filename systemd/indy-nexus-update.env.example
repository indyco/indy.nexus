# /etc/default/indy-nexus-update
#
# Configuration for update-lxc.sh. Copy this file to
# /etc/default/indy-nexus-update on the LXC (drop the .example suffix)
# and edit the values. The updater sources this file on every run,
# so changes take effect on the next timer tick (no restart needed).
#
# ---------------------------------------------------------------------
# REQUIRE_SIGNED
#
#   1 = Refuse to update unless every commit after ANCHOR_SHA is signed
#       by a key listed in ALLOWED_SIGNERS. This is the recommended
#       production setting.
#   0 = Skip verification entirely (legacy behaviour). Only use this
#       temporarily; the updater will log a warning on every run.
# ---------------------------------------------------------------------
REQUIRE_SIGNED=1

# ---------------------------------------------------------------------
# ANCHOR_SHA
#
# The SHA of the first commit you consider trusted. Commits BEFORE or
# AT this SHA are accepted without a signature check (they pre-date the
# move to signed commits). Commits AFTER this SHA must be signed.
#
# Set this to the SHA of your first signed commit on main, which you
# can obtain with:
#
#   git log --show-signature main | head
#
# Example:
# ANCHOR_SHA=abc1234def5678...
# ---------------------------------------------------------------------
ANCHOR_SHA=

# ---------------------------------------------------------------------
# ALLOWED_SIGNERS
#
# Path to the allowed_signers file. Defaults to the value shown below
# if left unset. This file must exist and contain at least one key when
# REQUIRE_SIGNED=1.
# ---------------------------------------------------------------------
ALLOWED_SIGNERS=/etc/indy-nexus/allowed_signers
